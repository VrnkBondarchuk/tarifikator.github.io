PORT=3000
PUBLIC_ORIGIN=https://tarifikator.dadehard.ru
DATA_DIR=./data
# Set only to the socket IP of a reverse proxy that overwrites X-Real-IP.
# Leave empty for a direct connection; never trust client-supplied X-Real-IP by default.
TRUSTED_PROXY_IPS=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
UNISENDER_API_KEY=
UNISENDER_TRIGGER_URL=
UNISENDER_MARKETING_LIST_ID=37
CONSENT_VERSION=legal-2026-10-ip-retention
